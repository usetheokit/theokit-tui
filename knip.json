{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/renderer/index.ts",
    "src/terminal/index.ts",
    "src/keys/index.ts",
    "examples/**/*.tsx",
    "examples/**/*.ts",
    "benchmarks/**/*.ts",
    "benchmarks/**/*.tsx",
    "src/**/index.ts",
    "scripts/sync-version.mjs",
    "scripts/gate-scope.mjs",
    "scripts/*.test.mjs"
  ],
  "ignore": ["tests/**"],
  "include": ["files"]
}
