{
  "name": "@theokit/tui",
  "version": "0.63.1",
  "description": "AI-native TUI primitives for agent CLIs \u2014 streaming chat, tool cards, diffs, agent timeline and metrics, built on Ink (React for the terminal)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-tui.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "default": "./dist/terminal/index.js"
    },
    "./keys": {
      "types": "./dist/keys/index.d.ts",
      "default": "./dist/keys/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "test -n \"$(git ls-files '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')\" && git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' | xargs -0 eslint --no-warn-ignored",
    "format": "git ls-files -z | xargs -0 prettier --write --ignore-unknown",
    "format:check": "test -n \"$(git ls-files)\" && git ls-files -z | xargs -0 prettier --check --ignore-unknown",
    "bench": "tsx benchmarks/run.ts",
    "example": "tsx examples/components/basic.tsx",
    "example:chat": "tsx examples/scenes/chat.tsx",
    "example:tools": "tsx examples/components/tools.tsx",
    "example:agent": "tsx examples/scenes/agent.tsx",
    "example:code": "tsx examples/components/code.tsx",
    "example:metrics": "tsx examples/components/metrics.tsx",
    "example:themes": "tsx examples/components/themes.tsx",
    "example:stream": "tsx examples/scenes/stream.tsx",
    "example:banner": "tsx examples/components/banner.tsx",
    "example:margin": "tsx examples/renderer/margin.tsx",
    "example:live": "tsx examples/scenes/live-agent-tui.tsx",
    "example:showcase": "tsx examples/scenes/showcase.tsx",
    "example:renderer": "tsx examples/renderer/renderer-skeleton.tsx",
    "example:all": "tsx examples/scenes/all-components.tsx",
    "gates": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm gates && pnpm build",
    "example:claude-code": "tsx examples/scenes/claude-code-scene.tsx",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "peerDependencies": {
    "figlet": "^1.7.0",
    "lowlight": "^3.0.0",
    "react": "^19.2.0"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.1.3",
    "chalk": "5.6.2",
    "cli-boxes": "4.0.1",
    "cli-truncate": "6.1.0",
    "diff": "^7.0.0",
    "ignore": "^7.0.5",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "parse-diff": "^0.12.0",
    "react-reconciler": "^0.33.0",
    "string-width": "8.2.1",
    "widest-line": "6.0.0",
    "wrap-ansi": "10.0.0",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@theokit/sdk": "^2.19.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-reconciler": "^0.33.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@xterm/headless": "5.5.0",
    "cli-spinners": "^2.9.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ink-testing-library": "^4.0.0",
    "lowlight": "3.3.0",
    "node-pty": "1.1.0",
    "prettier": "^3.3.0",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1"
    }
  },
  "peerDependenciesMeta": {
    "figlet": {
      "optional": true
    },
    "lowlight": {
      "optional": true
    }
  },
  "keywords": [
    "tui",
    "ink",
    "react",
    "terminal",
    "ai",
    "agent",
    "cli",
    "chat",
    "streaming",
    "llm"
  ]
}
