# Lives at the WORKSPACE ROOT, not in the package: pnpm resolves the tree from here, so a
# package-local .npmrc is NOT read during `pnpm install`. Measured (B-109) — while it sat in
# packages/tui/, figlet was auto-installed and figlet-art.test.ts went red, exactly as the
# README says it would.
#
# OPTIONAL peers (figlet, lowlight) must NOT be auto-installed: the degrade
# contract tests (figlet-art.test.ts returns_null_when_figlet_is_absent,
# code-block-absent.test.tsx) require the bare tree. Peers a test DOES need
# (react, lowlight) are explicit devDependencies instead.
auto-install-peers=false
